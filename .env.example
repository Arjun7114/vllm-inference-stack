# Copy this file to `.env` and adjust as needed. `.env` is gitignored.

# Which model backend to use:
#   mock  -> canned responses, no GPU, for local development
#   vllm  -> talk to a real vLLM OpenAI-compatible server
BACKEND=mock

# Used only when BACKEND=vllm — where the vLLM server is reachable.
VLLM_BASE_URL=http://localhost:8000
MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3

# API key clients must present (wired into auth in a later sub-step).
API_KEY=dev-key-change-me
